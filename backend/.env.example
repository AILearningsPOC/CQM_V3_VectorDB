# CQM v3 — Environment Variables
# Add these to Render dashboard → Environment

# NEW v3 Supabase project (NOT the v2 project — v2 stays untouched)
SUPABASE_URL=https://your-v3-project.supabase.co
SUPABASE_SERVICE_KEY=your-v3-service-role-key

# Qdrant Cloud (free 1GB tier) — cluster URL includes port, e.g.
# https://xyz-example.eu-central.aws.cloud.qdrant.io:6333
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=cqm_kb
QDRANT_TIMEOUT_MS=15000

GROQ_API_KEY=your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile

HF_API_KEY=hf_your-huggingface-token

SCRAPERAPI_KEY=your-scraperapi-key
APIFY_API_KEY=your-apify-token

SCRAPING_ENGINE=scraperapi

PORT=3000

MAX_SCRAPE_PAGES=5   # Max pages to scrape per product (each page = 30 questions)

# ── Migration script only (scripts/migrate-v2-kb.js) ──
# Read-only access to the v2 project to export the existing KB entries.
# V2_SUPABASE_URL=https://your-v2-project.supabase.co
# V2_SUPABASE_SERVICE_KEY=your-v2-service-role-key
